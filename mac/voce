#!/bin/bash
# Interruttori Voce:
#   voce on|off          -> voce agenti (lettura risposte ad alta voce)
#   voce mani on|off     -> mani libere (ascolto continuo senza tasto)
#   voce                 -> stato di entrambe
# Comandi usati anche dagli agenti quando chiedi a voce/chat di
# accendere o spegnere ("spegni il microfono" = voce mani off).
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$DIR/.venv/bin/python" ]; then
  PY="$DIR/.venv/bin/python"
elif [ -x "$DIR/../../.venv/bin/python" ]; then
  # Alias operativo di Sal: tools/voce -> sorgente unica della repo pubblica.
  PY="$DIR/../../.venv/bin/python"
else
  PY="$(command -v python3)"
fi
case "$1" in
  on)  touch "$DIR/VOICE_ON"; echo "Voce: ACCESA" ;;
  off) rm -f "$DIR/VOICE_ON"
       "$PY" "$DIR/parla.py" --stop
       echo "Voce: SPENTA" ;;
  mani)
    case "$2" in
      on)  touch "$DIR/MANI_LIBERE_ON"; echo "Mani libere: ATTIVE" ;;
      off) rm -f "$DIR/MANI_LIBERE_ON"; echo "Mani libere: SPENTE" ;;
      *)   [ -f "$DIR/MANI_LIBERE_ON" ] && echo "Mani libere: ATTIVE" || echo "Mani libere: SPENTE" ;;
    esac ;;
  *)
    [ -f "$DIR/VOICE_ON" ] && echo "Voce: ACCESA" || echo "Voce: SPENTA"
    [ -f "$DIR/MANI_LIBERE_ON" ] && echo "Mani libere: ATTIVE" || echo "Mani libere: SPENTE" ;;
esac
